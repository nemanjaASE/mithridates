# Copy to .env in this folder (cp .env.example .env) and uncomment what you change.
# Docker Compose reads it whether the demo is started from this folder or from the
# repository root. .env is in .gitignore: never commit it.
#
# Every line is commented out: compose.yaml already sets a lab value for each variable,
# and a line only takes effect once it is uncommented.

# --- Model -------------------------------------------------------------------
# Everything is local: both providers are Ollama and the agent is a LangGraph graph.
# No hosted API, no keys, no internet after the first pull. The service has no fallback
# path: without a model and a database it does not start.
#
# Models are chosen BY ROLE, not per call site. An assistant's spec asks for a role and
# the factory resolves it:
#   strong -> tool calling (the agent loop)
#   cheap  -> a single completion (the RAG assistant)
# PROMPTINJ_MODEL sets both roles; a per-role variable overrides one of them.
# PROMPTINJ_MODEL=qwen2.5:3b            # a small 3B with decent tool calling (alternative: llama3.2:3b)
# PROMPTINJ_MODEL_STRONG=qwen2.5:7b     # only the agent gets the stronger model
# PROMPTINJ_MODEL_CHEAP=llama3.2:3b     # only the RAG assistant
# PROMPTINJ_TEMPERATURE=0               # both roles; 0 = repeatable output, which a demo needs
# PROMPTINJ_TEMPERATURE_STRONG=0        # keep the agent at 0: tool calling degrades fast
# PROMPTINJ_TEMPERATURE_CHEAP=0.8       # only the RAG assistant: the same injection sometimes
#                                       # lands and sometimes does not; success is a probability
# PROMPTINJ_MAX_TOKENS=512              # the token ceiling per request, both roles
# PROMPTINJ_MAX_TOKENS_STRONG=1024      # only the agent
# PROMPTINJ_MAX_TOKENS_CHEAP=256        # only the RAG assistant
#
# The embedding model is tied to the pgvector table rather than to the task: the table can
# only be searched with vectors from the model that filled it. Change it and the seed job
# has to run again.
# PROMPTINJ_EMBED_MODEL=nomic-embed-text
# PROMPTINJ_EMBED_TIMEOUT=30

# --- PostgreSQL --------------------------------------------------------------
# The database is unreachable from the host (internal network), so the lab passwords in
# compose.yaml are only a convenience. Change them for anything more than a local run.
# PROMPTINJ_DB_ADMIN_PASSWORD=...       # superuser, used only by the seed job
# PROMPTINJ_DB_APP_PASSWORD=...         # the application (SELECT on accounts + credentials + documents)

# --- Tokens ------------------------------------------------------------------
# PROMPTINJ_JWT_SECRET=...              # JWT signing key, at least 32 bytes; the code has no default
# PROMPTINJ_JWT_TTL_SECONDS=900         # token lifetime in seconds

# --- Educational switches (a real application would have both off) -----------
# EXPOSE_PROMPT_TRACE=true              # show the prompt that was sent to the model
# EXPOSE_RAW_OUTPUT=false               # show the raw output before the check (bypasses the guard!)
